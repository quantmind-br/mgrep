  "config": {
    "description": "Configuration and CI/CD files (disabled by default)",
    "defaultEnabled": false,
    "patterns": [
      ".github/",
      ".gitlab/",
      ".circleci/",
      ".travis.yml",
      "Jenkinsfile",
      "azure-pipelines.yml",
      "Dockerfile*",
      "docker-compose*.yml",
      ".dockerignore",
      ".vscode/",
      "*.sublime-*",
      ".editorconfig",
      ".gitattributes",
      ".gitmodules",
      ".npmrc",
      ".yarnrc*",
      ".nvmrc",
      ".python-version",
      ".ruby-version",
      ".node-version",
      "Brewfile"
    ]
  }
}
